<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <!-- Console target: demonstrates composing multiple targets. -->
    <target name="console" xsi:type="Console" />
    <!-- File target: when run from the editor the working directory is the project root. -->
    <target name="file" xsi:type="File" fileName="godough-demo.log" keepFileOpen="false" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>